  targetPoint: 0
  enemySpeed: 0
  videoPlayer:
  - videoPlayer: {fileID: 1328661472}
    videoTexture: {fileID: 8400000, guid: f4bb64c9ff817ca4a88b6a0be8432b69, type: 2}
    fullText: 'IT WAS JUST ANOTHER QUITE FOR A METRO STATION SECURITY GUARD '
  - videoPlayer: {fileID: 498678003}
    videoTexture: {fileID: 8400000, guid: 844a02f267ed0d349ada4f511ee7b37f, type: 2}
    fullText: 'UNTIL HE FOUND A STRANGE, SEALED DOOR HIDDEN IN THE MAINTENANCE AREA.
      CURIOUS, HE CHECKED IT OUT... '
  - videoPlayer: {fileID: 684647997}
    videoTexture: {fileID: 8400000, guid: 545961b0aa0bc2447b3e77c6d99ea233, type: 2}
    fullText: AND THE FLOOR COLLAPSED BENEATH HIM.
  - videoPlayer: {fileID: 63109420}
    videoTexture: {fileID: 8400000, guid: 18eb5b210361d1c4f862395cc37ef58e, type: 2}
    fullText: 'HE WOKE UP DEEP UNDERGROUND, IN A DARK, ANCIENT CATACOMB.   '
  - videoPlayer: {fileID: 1876328667}
    videoTexture: {fileID: 8400000, guid: 8bb6210e6ec1a9940b4c3ac81529206e, type: 2}
    fullText: "Unarmed and disoriented, he searched for a way out\u2014 only to hear
      Growls.\n "
  - videoPlayer: {fileID: 84849412}
    videoTexture: {fileID: 8400000, guid: e2944df335b988f47ac5f5e0679b66da, type: 2}
    fullText: "That\u2019s when he heard them. Footsteps. Countless ones, Coming
      closer. Close every door they\u2019re coming from before he becomes one of
      them."
