MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1359897679}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bcb26d0c41157c14fbc0d6c7c0656407, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _videoPlayer: {fileID: 1258096949}
  VideoImage: {fileID: 691319133}
  SubtitleText: {fileID: 2146158339}
  Videos:
  - Url: frame1.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: IT WAS JUST ANOTHER QUITE FOR A METRO STATION SECURITY GUARD
    TypeText: {fileID: 0}
  - Url: frame2.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: UNTIL HE FOUND A STRANGE, SEALED DOOR HIDDEN IN THE MAINTENANCE AREA.
      CURIOUS, HE CHECKED IT OUT...
    TypeText: {fileID: 0}
  - Url: frame3.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: AND THE FLOOR COLLAPSED BENEATH HIM.
    TypeText: {fileID: 0}
  - Url: frame4.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: 'HE WOKE UP DEEP UNDERGROUND, IN A DARK, ANCIENT CATACOMB.   '
    TypeText: {fileID: 0}
  - Url: frame5.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: "Unarmed and disoriented, he searched for a way out\u2014 only to hear
      Growls."
    TypeText: {fileID: 0}
  - Url: frame6.mp4
    IsPlayed: 0
    OnlyType: 0
    BackGround: {fileID: 0}
    SubTitle: "That\u2019s when he heard them. Footsteps. Countless ones, Coming
      closer. Close every door they\u2019re coming from before he becomes one of
      them."
    TypeText: {fileID: 0}
  - Url: 
    IsPlayed: 0
    OnlyType: 1
    BackGround: {fileID: 1716305921}
    SubTitle: 'His routine night on the job had transformed into something far more
      sinister, and now every shadow could be his last. '
    TypeText: {fileID: 1636398450}
  lobbyPage: {fileID: 0}
